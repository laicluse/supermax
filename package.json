{
  "name": "@laicluse/supermax",
  "version": "1.0.0",
  "description": "Framework-free cell layout and navigation primitives for workspaces that open content below and to the right.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laicluse/supermax.git"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./cell-collection": "./src/cell-collection.js",
    "./cell-strip": "./src/cell-strip.js",
    "./navigation": "./src/navigation.js",
    "./layout": "./src/layout.js",
    "./workspace": "./src/workspace.js",
    "./workspace.css": "./src/workspace.css"
  },
  "files": [
    "src/cell-collection.js",
    "src/cell-strip.js",
    "src/layout.js",
    "src/navigation.js",
    "src/workspace.js",
    "src/workspace.css",
    "src/index.js",
    "docs/application-shell.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:docs": "node scripts/build-docs.mjs",
    "check:docs": "node scripts/build-docs.mjs --check",
    "test:node": "node test/smoke.test.js && node test/navigation.test.js && node test/deeplink.test.js",
    "test:bun": "bun test/smoke.test.js && bun test/navigation.test.js && bun test/deeplink.test.js",
    "test:browser": "node test/cell-strip.test.js && node --test --test-concurrency=1 test/workspace.test.js test/workspace-nested.test.js",
    "test": "npm run check:docs && npm run test:node && npm run test:browser",
    "check": "npm run test && npm run test:bun"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
